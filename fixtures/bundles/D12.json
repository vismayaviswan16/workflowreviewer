   "source": "UNITS = {\"waiting\": \"min\"}\n\ndef route(t):\n    if t.get(\"category\") is None:\n        return \"manual_review\"\n    if t.get(\"urgent\"):\n        return \"priority_queue\"\n    if t.get(\"waiting\") is not None and t.get(\"waiting\") >= 30:\n        return \"escalation\"\n    return \"normal_queue\"\n"
