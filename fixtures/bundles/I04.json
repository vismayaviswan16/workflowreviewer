   "linked_node": "n1",
   "source": "UNITS = {\"waiting\": \"min\"}\n\ndef route(ticket):\n    if ticket.get(\"category\") is None:\n        return \"manual_review\"\n    if ticket.get(\"urgent\"):\n        return \"priority_queue\"\n    if ticket.get(\"waiting\") is not None and ticket.get(\"waiting\") >= 30:\n        return \"escalation\"\n    return \"normal_queue\"\n"
